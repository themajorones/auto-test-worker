FROM fedora:44

RUN set -eux; \
    curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -; \
    dnf -y install \
      java-25-openjdk-headless \
      nodejs \
      curl \
      unzip \
      android-tools \
      findutils; \
    dnf clean all; \
    rm -rf /var/cache/dnf

WORKDIR /app

RUN set -eux; \
    useradd -r -u 1000 -m -d /app appuser

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD sh -c ': "${SERVER_PORT:?SERVER_PORT is required}"; curl -fsS "http://localhost:${SERVER_PORT}/health" || exit 1'

ENTRYPOINT ["sh", "-c", "set -eu; : \"${SERVER_PORT:?SERVER_PORT is required}\"; exec java --add-opens java.base/java.util.concurrent=ALL-UNNAMED -Xmx1g -Dserver.port=${SERVER_PORT} -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-dev} -jar /app/server.war"]
